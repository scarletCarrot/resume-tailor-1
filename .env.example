# OpenRouter (LLM extraction + generation) — required
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Resume Tailor

# Upstash Redis (company duplicate detection) — optional, free tier at https://upstash.com
# Create a database, then copy its REST URL/token from the Upstash console.
# Without these set, duplicate detection is silently disabled (resume generation still works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
